# TEMPLATE ONLY - placeholders. Copy to ".env.local.secrets" (git-ignored, never committed) and fill in real local values.
# Single source of truth for LOCAL secrets, loaded by scripts/run-local.ps1 (Windows) and docker-compose.local.yml (Docker).
# Format: NAME=value, one per line, no quotes. "__" stands for ":" in configuration. Do not use this file for Render or Ubuntu production.

# ---- Shared by Windows and Docker (must be identical in both) ----
# Same local database nsg_mobile_dev. The server host differs: Windows uses 127.0.0.1, Docker uses host.docker.internal (set below).
LOCAL_DB_USER=REPLACE_WITH_LOCAL_DB_USER
LOCAL_DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
LOCAL_DB_NAME=nsg_mobile_dev
Encryption__Key=REPLACE_WITH_BASE64_OF_EXACTLY_32_BYTES

# ---- Windows (dotnet run) only ----
WINDOWS_Jwt__Secret=REPLACE_WITH_RANDOM_BASE64_AT_LEAST_32_BYTES

# ---- Docker only (must differ from the Windows JWT values) ----
DOCKER_Jwt__Secret=REPLACE_WITH_DIFFERENT_RANDOM_BASE64_AT_LEAST_32_BYTES
DOCKER_Jwt__Issuer=NSG.Mobile.API.Docker
DOCKER_Jwt__Audience=NSG.Mobile.App.Docker
DOCKER_Jwt__AdminAudience=NSG.Mobile.Admin.Docker
