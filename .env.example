# Template only - copy to a private location (never commit the filled-in copy) and load it from the service manager.
# Format: NAME=value. "__" in a name stands for ":" in configuration. Generate keys with openssl, see docs/CONFIGURATION.md.

ASPNETCORE_ENVIRONMENT=Production

ConnectionStrings__MySql=Server=REPLACE_WITH_DB_HOST;Port=3306;Database=REPLACE_WITH_DB_NAME;Uid=REPLACE_WITH_DB_USER;Pwd=REPLACE_WITH_DB_PASSWORD;AllowUserVariables=True;SslMode=Required;

Jwt__Secret=REPLACE_WITH_RANDOM_BASE64_AT_LEAST_32_BYTES
Jwt__Issuer=REPLACE_WITH_ISSUER
Jwt__Audience=REPLACE_WITH_AUDIENCE

Encryption__Key=REPLACE_WITH_BASE64_OF_EXACTLY_32_BYTES
BlindIndex__Key=REPLACE_WITH_BASE64_AT_LEAST_32_BYTES_DIFFERENT_FROM_ENCRYPTION_KEY

FileStorage__BasePath=/var/lib/nsg-mobile-api/files

# Optional, when the integration goes live:
# Redis__ConnectionString=REPLACE_WITH_REDIS_CONNECTION_STRING
# Sms__ApiKey=REPLACE_WITH_SMS_API_KEY
# Hrms__ApiKey=REPLACE_WITH_HRMS_API_KEY
# Payroll__ApiKey=REPLACE_WITH_PAYROLL_API_KEY
# Fcm__CredentialPath=/etc/nsg-mobile-api/fcm-service-account-file
